# yamllint の設定。
#
# モノレポ化前は backend リポジトリの直下にあり、対象もそのリポジトリだけだった。
# 今は Repo/CI がリポジトリ全体を舐めるため、素の YAML として検証できないもの・
# 自分たちが書いていないものを除外する。
extends: default

ignore: |
  node_modules/
  .venv/
  .turbo/
  dist/
  .next/
  storybook-static/
  # Helm の templates は Go テンプレート（{{- ... }}）で、素の YAML としては
  # インデントも括弧も規則どおりにならない。ここは helm lint / helm template
  # （Infra/CI）が担当するので yamllint の対象から外す。
  infra/helm/**/templates/

rules:
  line-length:
    max: 120
    level: warning
