{
  // モノレポなので単一ルートで開ける。それでもパッケージごとにフォルダを
  // 切っておくと、言語サーバ（ESLint / TypeScript / Python）がパッケージ単位で
  // 設定を拾いやすく、検索スコープも絞りやすい。
  "folders": [
    { "path": ".", "name": "d-party (root)" },
    { "path": "backend", "name": "backend" },
    { "path": "extension", "name": "extension" },
    { "path": "frontend", "name": "frontend" },
    { "path": "infra", "name": "infra" }
  ],
  "settings": {
    "files.eol": "\n",
    "search.exclude": {
      "**/node_modules": true,
      "**/.venv": true,
      "**/.next": true,
      "**/.turbo": true,
      "**/dist": true,
      "**/storybook-static": true,
      "postgres/data": true,
      "backend/static": true
    }
  },
  "extensions": {
    "recommendations": [
      "ms-python.python",
      "ms-python.vscode-pylance",
      "charliermarsh.ruff",
      "dbaeumer.vscode-eslint",
      "esbenp.prettier-vscode",
      "ms-azuretools.vscode-docker",
      "redhat.vscode-yaml",
      "ms-kubernetes-tools.vscode-kubernetes-tools",
      "anthropic.claude-code"
    ]
  }
}
