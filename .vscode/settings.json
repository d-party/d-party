{
  // ── General ───────────────────────────────────────────────────────────────
  "editor.formatOnSave": true,
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,

  // ── Helm テンプレート ──────────────────────────────────────────────────────
  // {{- ... }} は Go テンプレートなので純 YAML として検証すると誤検知になる。
  // helm 言語に関連付けて YAML バリデーションの対象から外す。
  // 注意:
  //  - `helm` 言語は ms-kubernetes-tools.vscode-kubernetes-tools が提供する。
  //    未インストールだと関連付けは無効（YAML のまま誤検知が出る）。
  //  - files.associations のパターンは `/` を含むと「絶対パス」にマッチするため、
  //    先頭は `**/` で始める（`infra/...` 直書きだと絶対パスに一致しない）。
  "files.associations": {
    "**/infra/helm/**/templates/*.yaml": "helm",
    "**/infra/helm/**/templates/*.tpl": "helm"
  },

  // ── Python (backend/) ─────────────────────────────────────────────────────
  // backend は black から ruff へ移行済み（backend/pyproject.toml の [tool.ruff]）。
  // インタプリタは uv sync が backend/.venv に作るものを使う。
  "python.defaultInterpreterPath": "${workspaceFolder}/backend/.venv/bin/python",
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true
  },

  // ── TypeScript (extension/ · frontend/) ───────────────────────────────────
  // pnpm workspace なので typescript はルートの仮想ストアから解決される。
  "typescript.tsdk": "node_modules/typescript/lib",
  "[typescript]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[typescriptreact]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[javascript]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "eslint.workingDirectories": [{ "mode": "auto" }],

  // ── Search / watch ────────────────────────────────────────────────────────
  // ビルド生成物とベンダーディレクトリを検索とファイル監視から外す。
  "search.exclude": {
    "**/node_modules": true,
    "**/.venv": true,
    "**/.next": true,
    "**/.turbo": true,
    "**/dist": true,
    "**/storybook-static": true,
    "backend/static": true,
    "postgres/data": true,
    "grafana/data": true,
    "pnpm-lock.yaml": true,
    "backend/uv.lock": true
  },
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/.venv/**": true,
    "**/.next/**": true,
    "**/.turbo/**": true,
    "postgres/data/**": true,
    "grafana/data/**": true
  }
}
