# 本番の値。.env.global の後に読まれて上書きする。デプロイ前に実値へ書き換える。

DEBUG = 0
MY_DOMAIN = d-party.net

# Let's Encrypt の通知先（init-letsencrypt.sh）。
CERTBOT_EMAIL = admin@example.com

# next build で埋め込まれる。build 引数は env_file を読めないので、
# docker-compose.prod.yml の build.args にも同じ値を書いている。

NEXT_PUBLIC_BACKEND_HOST = d-party.net/
NEXT_PUBLIC_BACKEND_PROTOCOL = https://
NEXT_PUBLIC_WEBSOCKET_PROTOCOL = wss://
