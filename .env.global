# dev / prod 共通の値。DEBUG / MY_DOMAIN / NEXT_PUBLIC_* などは .env.dev / .env.prod に置く。
# backend はこのファイルを override=True で読むので、環境固有の値を置くと本番が上書きされる。

D_ANIME_STORE_DOMAIN = animestore.docomo.ne.jp

TZ = Asia/Tokyo
TIME_ZONE = Asia/Tokyo
LANGUAGE_CODE = ja

# DATABASE_USER (backend/.env.django) must match POSTGRES_USER.
POSTGRES_DB = d_party
POSTGRES_USER = d_party
POSTGRES_PASSWORD = password

# nginx のアップストリーム（host:port）。
DJANGO_UPSTREAM = django:8000
FRONTEND_UPSTREAM = frontend:3000

# frontend のサーバー側 fetch の宛先。公開ドメインだとコンテナ内から NAT ヘアピンで詰まる。

BACKEND_INTERNAL_ORIGIN = http://django:8000
