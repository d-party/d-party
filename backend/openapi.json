    "components": {
        "schemas": {
            "ApiMessage": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string"
                    }
                },
                "required": [
                    "message"
                ]
            },
            "Count": {
                "type": "object",
                "properties": {
                    "count": {
                        "type": "integer"
                    }
                },
                "required": [
                    "count"
                ]
            },
            "CountResult": {
                "type": "object",
                "properties": {
                    "data": {
                        "$ref": "#/components/schemas/Count"
                    }
                },
                "required": [
                    "data"
                ]
            },
            "LobbyRedirect": {
                "type": "object",
                "properties": {
                    "redirect_url": {
                        "type": "string",
                        "format": "uri",
                        "description": "dアニメストアの再生ページの URL。"
                    },
                    "part_id": {
                        "type": "string"
                    },
                    "room_id": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "title": {
                        "type": "string",
                        "description": "作品名。古い拡張機能が作ったルームでは空文字。"
                    }
                },
                "required": [
                    "part_id",
                    "redirect_url",
                    "room_id",
                    "title"
                ]
            },
            "PerDayCount": {
                "type": "object",
                "properties": {
                    "day": {
                        "type": "string",
                        "format": "date"
                    },
                    "count": {
                        "type": "integer"
                    }
                },
                "required": [
                    "count",
                    "day"
                ]
            },
            "PerDayResult": {
                "type": "object",
                "properties": {
                    "data": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/PerDayCount"
                        }
                    }
                },
                "required": [
                    "data"
                ]
            },
            "ReactionTypeCount": {
                "type": "object",
                "properties": {
                    "count": {
                        "type": "integer"
                    },
                    "reaction_type": {
                        "type": "string"
                    }
                },
                "required": [
                    "count",
                    "reaction_type"
                ]
            },
            "ReactionTypeCountResult": {
                "type": "object",
                "properties": {
                    "data": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/ReactionTypeCount"
                        }
                    }
                },
                "required": [
                    "data"
                ]
            },
            "ShieldsBadge": {
                "type": "object",
                "description": "shields.io の endpoint badge（https://shields.io/badges/endpoint-badge）。",
                "properties": {
                    "schemaVersion": {
                        "type": "integer"
                    },
                    "label": {
                        "type": "string"
                    },
                    "message": {
                        "type": "string"
                    },
                    "color": {
                        "type": "string"
                    },
                    "cacheSeconds": {
                        "type": "integer"
                    }
                },
                "required": [
                    "label",
                    "message",
                    "schemaVersion"
                ]
            },
            "VersionCheckResult": {
                "type": "object",
                "properties": {
                    "is_possible": {
                        "type": "boolean",
                        "description": "拡張機能のバージョンが backend の要求を満たすか。"
                    }
                },
                "required": [
                    "is_possible"
                ]
            }
        }
    }
}