        "/api/v1/anime-store/lobby/{room_id}": {
            "get": {
                "operationId": "lobbyResolve",
                "description": "Resolve a room id to the dアニメストア redirect URL.\n\nCalled by the frontend's lobby page (``/anime-store/lobby/<room_id>``).",
                "parameters": [
                    {
                        "in": "path",
                        "name": "room_id",
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        },
                        "required": true
                    }
                ],
                "tags": [
                    "v1"
                ],
                "security": [
                    {}
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/LobbyRedirect"
                                }
                            }
                        },
                        "description": ""
                    },
                    "404": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiMessage"
                                }
                            }
                        },
                        "description": ""
                    }
                }
            }
        },
        "/api/v1/chrome-extension/version-check": {
            "get": {
                "operationId": "versionCheck",
                "description": "Check whether a Chrome extension version is compatible with the backend.",
                "parameters": [
                    {
                        "in": "query",
                        "name": "extension-version",
                        "schema": {
                            "type": "string"
                        },
                        "description": "拡張機能のバージョン（x.y.z）。",
                        "required": true
                    }
                ],
                "tags": [
                    "v1"
                ],
                "security": [
                    {}
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/VersionCheckResult"
                                }
                            }
                        },
                        "description": ""
                    },
                    "400": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiMessage"
                                }
                            }
                        },
                        "description": ""
                    },
                    "406": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiMessage"
                                }
                            }
                        },
                        "description": ""
                    }
                }
            }
        },
