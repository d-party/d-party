# upstream の host:port は envsubst で .env.global から埋める。
upstream app_server {
    server ${DJANGO_UPSTREAM} fail_timeout=0;
}
upstream frontend_server {
    server ${FRONTEND_UPSTREAM} fail_timeout=0;
}

server {
    listen 80 default;
    server_name $MY_DOMAIN www.$MY_DOMAIN;

    keepalive_timeout 10;

    location /static/ {
            alias /static/;
    }


    location /.well-known/ {
        alias /.well-known/;
    }

    # ── Django (ASGI): REST API・管理画面 ──
    location /api/ {
        # 公開 API だけなので、pnpm dev（:3000）や拡張機能から叩けるよう CORS を許す。
        # add_header は named location へ引き継がれないので、ここで直接 proxy_pass する。
        add_header Access-Control-Allow-Origin "*" always;
        add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
        add_header Access-Control-Allow-Headers "Content-Type, Accept" always;
        if ($request_method = OPTIONS) {
            add_header Access-Control-Allow-Origin "*" always;
            add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
            add_header Access-Control-Allow-Headers "Content-Type, Accept" always;
            add_header Access-Control-Max-Age 86400 always;
            return 204;
        }
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_redirect off;
        proxy_pass http://app_server;
    }
    # /admin は上の prefix に合わずフロントの 404 になるので、/admin/ へ飛ばす。

    location = /admin {
        return 301 /admin/;
    }
    location /admin/ {
        try_files $uri @proxy_to_app;
    }
    # WebSocket（同時視聴の同期）。/anime-store/lobby/ はフロント、party/ は Django。
    location /anime-store/party/ {
        try_files $uri @proxy_to_app;
    }

    # ── React フロントエンド: 公開ページ（/ /usage /qa /anime-store/lobby/… と静的アセット）──
    location / {
        try_files $uri @proxy_to_frontend;
    }

    location @proxy_to_app {
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_redirect off;
        proxy_pass http://app_server;
    }

    location @proxy_to_frontend {
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_redirect off;
        proxy_pass http://frontend_server;
    }

}
