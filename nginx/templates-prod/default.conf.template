# envsubst で ${MY_DOMAIN} ${DJANGO_UPSTREAM} ${FRONTEND_UPSTREAM} を埋める。

upstream app_server {
    server ${DJANGO_UPSTREAM} fail_timeout=0;
}
upstream frontend_server {
    server ${FRONTEND_UPSTREAM} fail_timeout=0;
}

# ── :80 — Let's Encrypt チャレンジ応答 + HTTPS への恒久リダイレクト ──
server {
    listen 80 default;
    server_name ${MY_DOMAIN} www.${MY_DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type "text/plain";
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ── :443 — TLS 終端。アプリ本体への振り分け ──
server {
    listen 443 ssl;
    http2 on;
    server_name ${MY_DOMAIN} www.${MY_DOMAIN};
    keepalive_timeout 10;

    ssl_certificate     /etc/letsencrypt/live/${MY_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${MY_DOMAIN}/privkey.pem;
    include             /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam         /etc/letsencrypt/ssl-dhparams.pem;

    location /static/ {
        alias /static/;
    }

    # 計画メンテナンス: `touch nginx/maintenance.on` で各 location が 503（静的ページ）を返し、
    # `rm nginx/maintenance.on` で戻る。リクエストごとに見るので reload は要らない。

    # ── Django (ASGI): REST API・管理画面・WebSocket ──
    location /api/ {
        if (-f /etc/nginx/maintenance.on) {
            return 503;
        }
        add_header Access-Control-Allow-Origin "*" always;
        add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
        add_header Access-Control-Allow-Headers "Content-Type, Accept" always;
        if ($request_method = OPTIONS) {
            add_header Access-Control-Allow-Origin "*" always;
            add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
            add_header Access-Control-Allow-Headers "Content-Type, Accept" always;
            add_header Access-Control-Max-Age 86400 always;
            return 204;
        }
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_redirect off;
        proxy_pass http://app_server;
    }
    # /admin は上の prefix に合わずフロントの 404 になるので、/admin/ へ飛ばす。
    location = /admin {
        return 301 /admin/;
    }
    location /admin/ {
        if (-f /etc/nginx/maintenance.on) {
            return 503;
        }
        try_files $uri @proxy_to_app;
    }
    # WebSocket（同時視聴の同期）。party/ は Django、/anime-store/lobby/ はフロント。
    location /anime-store/party/ {
        if (-f /etc/nginx/maintenance.on) {
            return 503;
        }
        try_files $uri @proxy_to_app;
    }

    # ── React フロントエンド: 公開ページ + 静的アセット ──
    location / {
        if (-f /etc/nginx/maintenance.on) {
            return 503;
        }
        try_files $uri @proxy_to_frontend;
    }

    location @proxy_to_app {
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_redirect off;
        proxy_pass http://app_server;
    }

    location @proxy_to_frontend {
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_redirect off;
        proxy_pass http://frontend_server;
    }

    # upstream に届かない（502/504）ときと計画メンテナンス（503）のときに返す静的ページ。
    # upstream 自身が返した 5xx（/api/v1/health の 503 など）はそのまま通す。
    error_page 502 503 504 =503 /maintenance.html;
    location = /maintenance.html {
        internal;
        root /usr/share/nginx/maintenance;
        add_header Cache-Control "no-store" always;
        add_header Retry-After "60" always;
    }
}
