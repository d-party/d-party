# envsubst で ${MY_DOMAIN} ${DJANGO_UPSTREAM} ${FRONTEND_UPSTREAM} を埋める（.env.global / .env.prod）。
upstream app_server {
    server ${DJANGO_UPSTREAM} fail_timeout=0;
}
upstream frontend_server {
    server ${FRONTEND_UPSTREAM} fail_timeout=0;
}

# ── :80 — Let's Encrypt チャレンジ応答 + HTTPS への恒久リダイレクト ──
server {
    listen 80 default;
    server_name ${MY_DOMAIN} www.${MY_DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type "text/plain";
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ── :443 — TLS 終端。アプリ本体への振り分け ──
server {
    listen 443 ssl;
    http2 on;
    server_name ${MY_DOMAIN} www.${MY_DOMAIN};
    keepalive_timeout 10;

    ssl_certificate     /etc/letsencrypt/live/${MY_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${MY_DOMAIN}/privkey.pem;
    include             /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam         /etc/letsencrypt/ssl-dhparams.pem;

    # proxy_pass する location はすべてこれを継承する。location の中に proxy_set_header を
    # 1 つでも書くと、その location ではここの proxy_set_header が全部効かなくなる。
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_redirect off;

    location /static/ {
        alias /static/;
    }

    # ── Django (ASGI): REST API・管理画面・WebSocket ──
    location /api/ {
        # 公開 API だけなので、拡張機能など別オリジンから叩けるよう CORS を許す。
        add_header Access-Control-Allow-Origin "*" always;
        add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
        add_header Access-Control-Allow-Headers "Content-Type, Accept" always;
        # if の中へは外側の add_header が継承されないので、同じものを書く。
        if ($request_method = OPTIONS) {
            add_header Access-Control-Allow-Origin "*" always;
            add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
            add_header Access-Control-Allow-Headers "Content-Type, Accept" always;
            add_header Access-Control-Max-Age 86400 always;
            return 204;
        }
        proxy_pass http://app_server;
    }
    # /admin は下の prefix に合わずフロントの 404 になるので、/admin/ へ飛ばす。
    location = /admin {
        return 301 /admin/;
    }
    location /admin/ {
        try_files $uri @proxy_to_app;
    }
    # WebSocket（同時視聴の同期）。/anime-store/lobby/ はフロント、party/ は Django。
    location /anime-store/party/ {
        try_files $uri @proxy_to_app;
    }

    # ── Next.js フロントエンド: 公開ページ + 静的アセット ──
    location / {
        try_files $uri @proxy_to_frontend;
    }

    # try_files 経由で named location へ渡す。prefix location に proxy_pass を直接書くと、nginx が
    # 末尾スラッシュ無しのリクエスト（/anime-store/party など）を 301 で補完するようになる。
    location @proxy_to_app {
        proxy_pass http://app_server;
    }
    location @proxy_to_frontend {
        proxy_pass http://frontend_server;
    }

    error_page 500 502 503 504 /50x.html;
    location = /50x.html {
        root /usr/share/nginx/html;
    }
}
