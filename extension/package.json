{
  "name": "d-party-chrome-extension",
  "version": "2.11.11",
  "description": "dアニメストアで『同時視聴』を実現する d-party の Chrome 拡張機能 (Manifest V3 / TypeScript)",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rspack build",
    "build:prod": "D_PARTY_ENV=production rspack build",
    "dev": "rspack build --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "api:generate": "orval --config orval.config.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "license:check": "pnpm dlx license-checker-rseidelsohn@5.0.1 --production --excludePrivatePackages --onlyAllow \"$(grep -v '^[[:space:]]*#' license-whitelist-node.txt | grep -v '^[[:space:]]*$' | paste -sd ';')\""
  },
  "dependencies": {
    "@d-party/ui": "workspace:*",
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "framer-motion": "^13.4.2",
    "lottie-react": "^3.1.2",
    "lucide-react": "^1.50.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "react-use": "^17.6.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rspack/cli": "^2.2.8",
    "@rspack/core": "^2.2.8",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/react": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/chrome": "^0.3.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.6.1",
    "globals": "^17.13.0",
    "orval": "^8.39.0",
    "postcss": "^8.5.28",
    "postcss-loader": "^8.1.1",
    "prettier": "^3.9.9",
    "storybook": "^10.6.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2"
  },
  "packageManager": "pnpm@12.4.2"
}
