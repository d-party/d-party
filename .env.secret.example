# 本番の秘密値。`cp .env.secret.example .env.secret` で作り、値を書き換える。
# .env.secret は gitignore 済み。docker-compose.prod.yml が django と postgres に注入する。
#
# SECRET_KEY は AnimeUser.user_name の暗号鍵も兼ねる。運用開始後に変えると既存の表示名を
# 復号できなくなる。生成例:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY = change-me
# postgres の初回起動（データディレクトリが空のとき）にだけ反映される。
POSTGRES_PASSWORD = change-me
